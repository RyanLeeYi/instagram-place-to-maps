# Telegram
TELEGRAM_BOT_TOKEN=your_food_bot_token
TELEGRAM_ALLOWED_CHAT_IDS=your_chat_id

# Whisper 本地模型設定
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# Ollama 本地 LLM 設定
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=minicpm-v

# Google Places API
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Webhook 設定
WEBHOOK_URL=https://food.yourdomain.com

# 系統設定
TEMP_VIDEO_DIR=./temp_videos
DATABASE_URL=sqlite+aiosqlite:///./food_places.db

# ===== Google Maps 自動儲存設定 =====
# 是否啟用自動儲存至 Google Maps 清單
GOOGLE_MAPS_SAVE_ENABLED=false

# 預設儲存的清單名稱
GOOGLE_MAPS_DEFAULT_LIST=想去

# Playwright 瀏覽器狀態儲存路徑
PLAYWRIGHT_STATE_PATH=./browser_state

# 自動化操作延遲（秒），用於避免被偵測
PLAYWRIGHT_DELAY_MIN=2.0
PLAYWRIGHT_DELAY_MAX=5.0

# Gemini 影片理解（Antigravity CLI）——本地擷取之外的第二來源，失敗自動降級
GEMINI_VIDEO_ENABLED=true
AGY_COMMAND=agy
GEMINI_VIDEO_TIMEOUT=240

# 合併階段的後端鏈與執行模式（F27.2/F27.3）
# MERGE_BACKENDS：逗號分隔的後端名稱鏈，合法名稱：ollama（本地）、
#                 agy／claude／codex（走已登入的訂閱 CLI，不吃 API key）
# MERGE_MODE：failover（依鏈序試到第一個成功為止）或 vote（鏈上後端同時跑，多數決）
#             運行中可用 /mergemode 指令覆寫，不必重啟
MERGE_BACKENDS=ollama
MERGE_MODE=failover

# CLI 版合併後端（F27.3）共用逾時（秒）；CLAUDE_COMMAND／CODEX_COMMAND
# 預設用 PATH 上的名稱，CLI 不在 PATH 上才需要改成完整路徑
MERGE_CLI_TIMEOUT=240
CLAUDE_COMMAND=claude
CODEX_COMMAND=codex
